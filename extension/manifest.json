{
  "manifest_version": 3,
  "name": "MarkeTrust",
  "version": "0.2.0",
  "description": "Analyze trust and risk signals on online marketplace listings.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "ui/images/icon-16.png",
    "32": "ui/images/icon-32.png",
    "48": "ui/images/icon-48.png",
    "128": "ui/images/icon-128.png"
  },
  "action": {
    "default_title": "MarkeTrust",
    "default_icon": {
      "16": "ui/images/icon-16.png",
      "32": "ui/images/icon-32.png",
      "48": "ui/images/icon-48.png",
      "128": "ui/images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/images/icon.svg"],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ]
    }
  ]
}
